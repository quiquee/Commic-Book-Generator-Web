# Copia este archivo a .env.local (ignorado por git) y ajusta los valores.

# Clave de Gemini. Solo la usa el servidor (proxy /api/gemini); nunca llega al navegador.
GEMINI_API_KEY=

# Contraseña del panel /admin. Sin ella el panel queda deshabilitado.
ADMIN_PASSWORD=

# Puerto del servidor. Tiene prioridad sobre server.port de vite.config.ts; sin él se usa ese valor
# (o 3000 si Vite no está instalado, p. ej. con npm ci --omit=dev).
PORT=7000

# URL pública de la aplicación usada en los enlaces y códigos QR de invitación.
# Si se omite, se usa la URL con la que se accede a la aplicación.
# PUBLIC_BASE_URL=https://comics.example.com

# Límites diarios (UTC) del proxy de Gemini; 0 o vacío = sin límite.
# El de dinero requiere .data/pricing.json (ver pricing.example.json).
# GEMINI_DAILY_BUDGET_USD=5
# GEMINI_DAILY_TOKEN_LIMIT=2000000

# Pon 1 si el servidor está detrás de un proxy inverso HTTPS (cookie Secure e IP real).
# TRUST_PROXY=1
